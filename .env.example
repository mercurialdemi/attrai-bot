# Copia questo file in .env per provare il bot sul tuo computer.
# Su Render invece inserisci queste stesse voci nella scheda Environment.
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
APIFY_TOKEN=
# ID Telegram tuo e del tuo socio, separati da virgola (li trovi scrivendo /id al bot)
ALLOWED_USER_IDS=
# Chi riceve il report delle 8 (facoltativo, di default tutti gli ALLOWED_USER_IDS)
REPORT_CHAT_IDS=
# Su Render, con il disco montato su /data:
DATA_DIR=/data
# Facoltativi
# CLAUDE_MODEL=claude-sonnet-5-5
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# SLIDE_TEXT_MODE=gemini
